# ============================================================
# TaxCollect - Environment Variables
# Copy this file to .env and fill in the values
# DO NOT commit the .env file
# ============================================================

# Server
SERVER_PORT=9090

# Database
DB_URL=jdbc:postgresql://localhost:5440/taxCollect
DB_USERNAME=directus
DB_PASSWORD=your_db_password_here

# LDAP
LDAP_URL=ldap://host.docker.internal:389
LDAP_BASE=cn=admin,dc=mairie,dc=com
LDAP_USERNAME=cn=admin,dc=mairie,dc=com
LDAP_PASSWORD=your_ldap_password_here
LDAP_USERS_BASE=ou=users,dc=mairie,dc=com

# Keycloak
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/mairie
KEYCLOAK_ADMIN_HOST=http://localhost:8080
KEYCLOAK_ADMIN_REALM=mairie
KEYCLOAK_ADMIN_CLIENT_ID=keycloak-admin-client
KEYCLOAK_ADMIN_CLIENT_SECRET=your_client_secret_here
JWT_RESOURCE_ID=tax-backend

# JPA
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# Swagger
SPRINGDOC_SHOW_ACTUATOR=false
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true

# Active Spring profile (dev, prod, etc.)
# SPRING_PROFILES_ACTIVE=dev
